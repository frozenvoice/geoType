{
  "name": "geotype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "geodata:sync": "tsx scripts/geodata/sync.ts",
    "geodata:validate": "tsx scripts/geodata/validate.ts && tsx scripts/geodata/validateWorldCountries.ts && tsx scripts/geodata/validateWorldPopulatedPlaces.ts",
    "geodata:stats": "tsx scripts/geodata/stats.ts",
    "geodata:language-stats": "tsx scripts/geodata/languageStats.ts",
    "geodata:import:countries": "tsx scripts/geodata/importNaturalEarthCountries.ts",
    "geodata:import:places": "tsx scripts/geodata/importNaturalEarthPopulatedPlaces.ts",
    "map:quality": "tsx scripts/map-quality.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run geodata:validate && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "6.4.1",
    "pmtiles": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
