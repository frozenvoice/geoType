VITE_MAP_PROVIDER=hosted
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_ACCESS_TOKEN=
VITE_MAP_TOKEN_PARAMETER=access_token
VITE_MAP_ATTRIBUTION=
VITE_PM_TILES_URL=
VITE_GEO_CATALOG_BASE_URL=/geodata

# Production is the default and reads /geodata/world/countries.geojson and
# /geodata/world/countries-index.json, plus populated-places.json and its index
# in the same directory. The small manifest/shard fixture is
# development/test-only and must be enabled explicitly.
VITE_GEO_FIXTURE_ENABLED=false
VITE_GEO_FIXTURE_BASE_URL=/geodata

# UI locale, typing language, and strict/casual answer policy are player
# settings stored in geotype.language-settings.v1; they are not env settings.

# Optional commercial hosted-style override (never commit a real API key):
# VITE_MAP_PROVIDER=hosted
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v4/style.json?key=YOUR_API_KEY

# Optional DEM terrain. SOURCE_ID is required when enabled and may refer to an
# existing raster-dem source in the style. Otherwise set either SOURCE_URL
# (TileJSON) or TILES (JSON array/comma-separated tile templates), not both.
VITE_MAP_TERRAIN_ENABLED=false
VITE_MAP_TERRAIN_SOURCE_ID=
VITE_MAP_TERRAIN_SOURCE_URL=
VITE_MAP_TERRAIN_TILES=
VITE_MAP_TERRAIN_TILE_SIZE=512
VITE_MAP_TERRAIN_EXAGGERATION=1.15

# Optional 3D buildings for styles without a data-backed fill-extrusion layer.
# OpenFreeMap Liberty already supplies building-3d and is auto-discovered.
# SOURCE_ID and SOURCE_LAYER must come from the loaded style; never guess them.
VITE_MAP_BUILDINGS_ENABLED=false
VITE_MAP_BUILDINGS_SOURCE_ID=
VITE_MAP_BUILDINGS_SOURCE_LAYER=
VITE_MAP_BUILDINGS_LAYER_ID=geotype-3d-buildings
VITE_MAP_BUILDINGS_MIN_ZOOM=14

# map:quality requires every applicable result to be explicitly pass or fail.
# MAP_QUALITY_APPROVED is intentionally not accepted as a shortcut.
MAP_QUALITY_WORLD_GLOBE_RESULT=
MAP_QUALITY_KOREA_BOUNDARY_RESULT=
MAP_QUALITY_SEOUL_DETAIL_RESULT=
MAP_QUALITY_LABELS_RESULT=
MAP_QUALITY_TARGET_VISIBILITY_RESULT=
MAP_QUALITY_CAMERA_RESULT=
MAP_QUALITY_DESKTOP_RESULT=
MAP_QUALITY_MOBILE_RESULT=
# Required only when the corresponding optional capability is enabled.
MAP_QUALITY_TERRAIN_RESULT=
MAP_QUALITY_BUILDINGS_RESULT=

VITE_LEADERBOARD_MODE=local
VITE_API_BASE_URL=
